<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root prefHeight="155.0" prefWidth="321.0" type="VBox" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" style="-fx-background-color: pink;">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="DELETE TAXPAYER" textAlignment="CENTER">
               <font>
                  <Font size="20.0" />
               </font></Text>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter &quot;DELETE&quot; to Confirm Deletion" textAlignment="CENTER">
               <font>
                  <Font size="18.0" />
               </font></Text>
            <TextField fx:id="textField" alignment="CENTER" promptText="DELETE">
               <font>
                  <Font size="18.0" />
               </font></TextField>
            <HBox alignment="CENTER" prefHeight="0.0" prefWidth="202.0" spacing="10.0">
               <children>
                  <Button id="red-button" fx:id="delButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#delete" stylesheets="@application.css" text="Delete" textFill="WHITE">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="fas-trash" />
                     </graphic>
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</fx:root>
