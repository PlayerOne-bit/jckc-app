<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<fx:root fx:id="root" maxWidth="1.7976931348623157E308" orientation="VERTICAL" style="-fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: gray;" type="FlowPane" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <FlowPane alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefWidth="${root.width - 20}">
         <children>
            <Text fx:id="tinNumber" strokeType="OUTSIDE" strokeWidth="0.0" text="XXX-XXX-XXX-XXX" textAlignment="RIGHT" wrappingWidth="${root.width - 20}">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
         </children>
      </FlowPane>
      <Text fx:id="taxpayerName" strokeType="OUTSIDE" strokeWidth="0.0" text="Claudio, Julie Christie y Kallos" wrappingWidth="${root.width - 20}">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Text>
      <Text fx:id="tradeName" strokeType="OUTSIDE" strokeWidth="0.0" text="JCKC and Bookkeeping and Services" wrappingWidth="${root.width - 20}">
         <font>
            <Font size="18.0" />
         </font>
      </Text>
      <Text fx:id="businessAddress" strokeType="OUTSIDE" strokeWidth="0.0" text="Purok 1, Gajo, Tiwi, Albay" wrappingWidth="${root.width - 20}">
         <font>
            <Font size="18.0" />
         </font>
      </Text>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</fx:root>
