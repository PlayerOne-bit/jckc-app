<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<fx:root maxWidth="Infinity" spacing="2.0" style="-fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: gray;" type="VBox" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <GridPane hgap="10.0" maxWidth="Infinity">
         <columnConstraints>
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.67" />
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.67" />
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.67" />
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.67" />
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.67" />
		    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="0.0" percentWidth="16.65" />
		</columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
         <children>
		    <Text fx:id="period"
		          text="January 2026"
		          GridPane.columnIndex="0">
		        <font>
		            <Font name="System Bold" size="14.0" />
		        </font>
		    </Text>
		
		    <Text fx:id="salesRow"
		          text="0"
		          GridPane.columnIndex="1" />
		
		    <Text fx:id="purchasesRow"
		          text="0"
		          GridPane.columnIndex="2" />
		
		    <Text fx:id="outputVat"
		          text="₱ 0.00"
		          GridPane.columnIndex="3" />
		
		    <Text fx:id="inputVat"
		          text="₱ 0.00"
		          GridPane.columnIndex="4" />
		
		    <Text fx:id="taxDue"
		          text="₱ 0.00"
		          GridPane.columnIndex="5">
		        <font>
		            <Font name="System Bold" size="14.0" />
		        </font>
		    </Text>
		</children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="50.0">
         <children>
            <Text fx:id="dateCreated" strokeType="OUTSIDE" strokeWidth="0.0" text="Date Created: " />
            <Text fx:id="dateModified" strokeType="OUTSIDE" strokeWidth="0.0" text="Date Modified: " />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</fx:root>
